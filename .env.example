# --- Database (any Postgres: Neon, Supabase, Vercel Postgres, local, ...) ---
# Include ?sslmode=require for hosted databases.
DATABASE_URL=postgres://user:password@localhost:5432/joans_kitchen

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in. Authorized redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show the "Sign in with Google" buttons
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Email (verification + password reset) via Resend ---
# Without RESEND_API_KEY, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Joan's Kitchen <noreply@yourdomain.com>"

# --- Photo storage (Vercel Blob) ---
# Without a token, development writes uploads to public/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Search / misc ---
NEXT_PUBLIC_ALGOLIA_APPID=
NEXT_PUBLIC_ALGOLIA_APIKEY=
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=
NEXT_PUBLIC_UNDER_CONSTRUCTION=false

# --- One-off Firebase -> Postgres migration (npm run migrate:firebase) ---
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
